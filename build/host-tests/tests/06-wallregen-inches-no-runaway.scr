; HCWWALLREGEN in an inch drawing (faces of a 120 x 96 in room, 9 in apart): the walls stay inside the plan. D-002 was wall lines running thousands of
; units across the sheet because the unit scale was inverted; the drawing extents must stay close to the 120 x 96 plan.
; TEMPLATE: acad.dwt
; EXPECT: 4 centre line\(s\) found between the faces: 4 at 9 in
; EXPECT: junctions - 4 corner\(s\)
; EXPECT: RESULT-EXT OK=1
; REJECT: no two lines face each other
(defun cnt (f / s) (if (setq s (ssget "X" f)) (sslength s) 0))
-LAYER M A-WALL

LINE 0,0 120,0 120,96 0,96 C
LINE 9,9 111,9 111,87 9,87 C
HCWWALLREGEN



_.ZOOM E
(princ (strcat "\nRESULT-EXT OK=" (if (and (< (car (getvar "EXTMAX")) 200) (< (cadr (getvar "EXTMAX")) 200) (> (car (getvar "EXTMIN")) -80) (> (cadr (getvar "EXTMIN")) -80)) "1" "0") " EXTMAX=" (rtos (car (getvar "EXTMAX")) 2 2) "," (rtos (cadr (getvar "EXTMAX")) 2 2) " WALL=" (itoa (cnt '((8 . "A-WALL") (0 . "LWPOLYLINE"))))))
