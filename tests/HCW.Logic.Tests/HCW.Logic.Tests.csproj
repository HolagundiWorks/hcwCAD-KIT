<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the CAD-free logic in src/HCW.AutoCAD.Plugin/Logic. No AutoCAD, BricsCAD or ZWCAD needed. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\HCW.AutoCAD.Plugin\Logic\*.cs" LinkBase="Logic" />
    <Compile Include="..\..\src\HCW.AutoCAD.Plugin\LayerData.cs" LinkBase="Logic" />
  </ItemGroup>

  <ItemGroup>
    <!-- the AQC bridge contract: schema and sample files, read by BridgeContractTests -->
    <None Include="..\..\docs\bridge\hcw-aqc-bridge.schema.json" Link="bridge\hcw-aqc-bridge.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\bridge\fixtures\*.json" Link="bridge\fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
