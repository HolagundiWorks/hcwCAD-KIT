<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>HCW.AutoCAD.Plugin</RootNamespace>
    <AssemblyName>hcwCAD-KIT</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);ZWCAD</DefineConstants>
    <ZwcadInstallDir Condition="'$(ZwcadInstallDir)'==''">$(ZWCAD_INSTALL_DIR)</ZwcadInstallDir>
    <ZwcadInstallDir Condition="'$(ZwcadInstallDir)'==''">C:\Program Files\ZWSOFT\ZWCAD 2026\</ZwcadInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ZwManaged">
      <HintPath>$(ZwcadInstallDir)ZwManaged.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZwcadInstallDir)ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="ZwDatabaseMgdBrep" Condition="Exists('$(ZwcadInstallDir)ZwDatabaseMgdBrep.dll')">
      <HintPath>$(ZwcadInstallDir)ZwDatabaseMgdBrep.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="ZwWindows" Condition="Exists('$(ZwcadInstallDir)ZwWindows.dll')">
      <HintPath>$(ZwcadInstallDir)ZwWindows.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="ZdWindows" Condition="Exists('$(ZwcadInstallDir)ZdWindows.dll')">
      <HintPath>$(ZwcadInstallDir)ZdWindows.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\HCW.AutoCAD.Plugin\Resources\Icons\**\*.png">
      <Link>Resources\Icons\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="RewriteCadSources" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\Rewrite-CadUsings.ps1&quot; -SourceRoot &quot;$(MSBuildProjectDirectory)\..\HCW.AutoCAD.Plugin&quot; -Destination &quot;$(IntermediateOutputPath)cadsrc&quot; -Platform zwcad" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)cadsrc\**\*.cs" />
    </ItemGroup>
  </Target>

</Project>
